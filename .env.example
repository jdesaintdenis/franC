# Copy to .env.local (git-ignored) and adjust if needed.
# These defaults match docker-compose.yml.

# Postgres container config (used by docker-compose.yml)
POSTGRES_USER=franc
POSTGRES_PASSWORD=franc
POSTGRES_DB=franc_dev
POSTGRES_PORT=5432

# App database connections
DATABASE_URL=postgres://franc:franc@localhost:5432/franc_dev
DATABASE_URL_TEST=postgres://franc:franc@localhost:5432/franc_test

# Better Auth
# BETTER_AUTH_SECRET is generated by `pnpm setup` if missing (or run
# `openssl rand -base64 32` yourself).
BETTER_AUTH_SECRET=
# Public URL of the app. Optional on Vercel production (falls back to the project's production
# domain); set it for a custom domain or any other host.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated, case-insensitive list of emails allowed to sign up.
# Empty/unset means nobody may sign up.
ALLOWED_EMAILS=owner@example.com,e2e@example.com,e2e-new@example.com

# Playwright derives one user per worker from E2E_USER_EMAIL (e2e+w0@example.com, ...)
# and recreates them directly in the database, so those need no ALLOWED_EMAILS entry.
# e2e-new@example.com (first-run spec) signs up through the app, so it must be allowed.
E2E_USER_EMAIL=e2e@example.com
E2E_USER_PASSWORD=e2e-password-123

# Optional / tooling (not needed for a normal local setup)
# FORCE_DB_RESET=1        # allow `pnpm db:reset` against a non-local host
# E2E_DEV=1               # Playwright: test against `next dev` instead of a production build
# PW_WORKERS=4            # Playwright: number of parallel workers (default 4, 2 on CI)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=  # use a preinstalled Chromium
# VERCEL_GIT_COMMIT_SHA=  # set by Vercel; used as the service worker precache revision
# VERCEL_ENV=             # set by Vercel (production / preview / development)
# VERCEL_PROJECT_PRODUCTION_URL=  # set by Vercel; auth base URL on production when BETTER_AUTH_URL is unset
# CI=                     # set by CI; disables Playwright dev-server reuse

# Import reminder push notification (all optional). Without VAPID_* the notification
# option is hidden in Settings and the in-app banner still works. `pnpm setup`
# generates local values if missing. Generate VAPID keys with:
#   pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: or https: URL.
VAPID_SUBJECT=mailto:owner@example.com
# Protects GET /api/cron/daily (Authorization: Bearer <secret>). Vercel Cron
# sends it automatically when CRON_SECRET is set; unset means the route returns 404.
CRON_SECRET=

# Bank sync through Enable Banking (optional). Without both, More > Bank connection is hidden.
# The key is the application's .pem content: as is, with \n instead of line breaks, or base64.
# See docs/deployment.md. Never commit a real key.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Comma-separated emails that get bank sync. Unset means nobody: other users of the deployment
# never see it, since the free mode reads the application owner's accounts.
BANK_SYNC_EMAILS=
# ENABLE_BANKING_API_ORIGIN=https://api.enablebanking.com  # tests point this at the fake server

# Nightly encrypted backup. The daily cron backs up to a private Vercel Blob store when BOTH are set
# (connecting a private Blob store to the project sets BLOB_READ_WRITE_TOKEN). See docs/backups.md.
BACKUP_AGE_RECIPIENT=
BLOB_READ_WRITE_TOKEN=
# `pnpm db:backup` (backup to a folder) and optionally the cron: a read-only role on the direct (non-pooler) host.
# The cron falls back to DATABASE_URL; the dump always runs in a READ ONLY transaction.
# BACKUP_DATABASE_URL=
# BACKUP_OUTPUT_DIR=./backups
# `pnpm db:restore <file>`: a new, EMPTY database, and the age-keygen key file. Never the production database.
# RESTORE_DATABASE_URL=
# BACKUP_AGE_IDENTITY_FILE=
